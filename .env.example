# Daedalus AI Environment Configuration

# Application
APP_NAME=Daedalus AI
ENV=development
PORT=8000
DEBUG=True

# Database (Postgres with pgvector)
# If PostgreSQL is not reachable, backend automatically falls back to an embedded dev database!
DATABASE_URL=postgresql+asyncpg://daedalus:daedalus_password@localhost:5432/daedalus_db

# GitHub Webhook Security
GITHUB_WEBHOOK_SECRET=daedalus_secret_key_123

# CORS
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# LLM & Embeddings (Optional: falls back to local fast ONNX vectorizer)
OPENAI_API_KEY=
GEMINI_API_KEY=
